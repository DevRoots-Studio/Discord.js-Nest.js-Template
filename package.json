{
  "name": "discord-bot-nestjs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot + NestJS backend with Prisma and Docker",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:db && npm run build:api && npm run build:bot && node scripts/postbuild.js",
    "build:db": "npm run build --workspace=@repo/database",
    "build:api": "npm run build --workspace=@repo/api",
    "build:bot": "npm run build --workspace=@repo/discord-bot",
    "start:api": "node dist/api/main.js",
    "start:bot": "npm run start --workspace=@repo/discord-bot",
    "dev": "npx concurrently -n api,bot -c blue,green \"npm run dev --workspace=@repo/api\" \"npm run dev --workspace=@repo/discord-bot\"",
    "dev:api": "npm run dev --workspace=@repo/api",
    "dev:bot": "npm run dev --workspace=@repo/discord-bot",
    "db:generate": "npm run generate --workspace=@repo/database",
    "db:migrate": "npm run migrate:deploy --workspace=@repo/database",
    "db:migrate:dev": "npm run migrate:dev --workspace=@repo/database"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
