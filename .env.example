# Database (required for API and bot)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_app

# Discord bot
BOT_TOKEN=your_discord_bot_token_here

# API
PORT=3000

# Bot–backend bridge (internal HTTP)
# In Docker: use http://discord-bot:3100 so the API service can reach the bot
BOT_BRIDGE_URL=http://localhost:3100
BRIDGE_PORT=3100
BRIDGE_SECRET=your_shared_secret_for_bridge_auth

# Bot → API (optional; for reporting events or fetching config)
# In Docker: use http://api:3000
API_URL=http://localhost:3000
